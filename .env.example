# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Postgres credentials used by compose.
POSTGRES_USER=archivyy
POSTGRES_PASSWORD=archivyy
POSTGRES_DB=archivyy

# Used when running the app outside compose (make run).
# Inside compose the app builds its own URL pointing at the db service.
DATABASE_URL=postgres://archivyy:archivyy@localhost:5432/archivyy?sslmode=disable
